// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  ADMIN
  GESTIONNAIRE_DEPENSE
  SUPER_ADMIN
  EQUIPE_TRESORERIE
}

enum MemberStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum OtpChannel {
  SMS
  EMAIL
}

enum SubscriptionStatus {
  DRAFT
  PENDING_CONSENT
  ACTIVE
  ACTIVE_MANUAL
  CANCELLED
}

enum Frequency {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

enum PaymentMethod {
  BANK_TRANSFER
  WALLET
  VIREMENT_BANCAIRE
  CASH
  CHEQUE
}

enum WalletProvider {
  WAAFI
  CAC_PAY
  D_MONEY
  SABAPAY
  DAHABPLACE
}

enum PaymentMode {
  AUTOMATIC
  MANUAL
}

enum AccountType {
  CLIENT_ADHERENT
  ASSOCIATION
}

enum ExpenseType {
  ALIMENTATION
  CONSTRUCTION
  MEDICAMENT
}

enum Country {
  DJIBOUTI
  ETHIOPIE
}

enum ExpenseStatus {
  EN_ATTENTE
  APPROUVER
  EFFECTUER
  REJETER
}

enum Currency {
  FRANC
  DOLLAR
  BIRR_ETHIOPIEN
}

enum PaymentOrderStatus {
  CREE
  IMPRIME
  // L'argent a réellement quitté la banque. Jusqu'ici une dépense passait en
  // EFFECTUER à la seconde où le bon était créé, avant même d'être imprimé,
  // alors que le virement part des jours plus tard — et parfois jamais.
  EXECUTE
  ANNULE
}

enum PublicSubmissionKind {
  PROJECT_PROPOSAL
  VOLUNTEER
}

/// Etat d'un ENCAISSEMENT, a ne pas confondre avec l'etat de l'engagement.
enum ContributionStatus {
  PENDING
  CONFIRMED
  FAILED
  /// La banque n'a pas repondu dans le delai. Surtout pas FAILED : le paiement
  /// a pu aboutir de son cote. C'est la reconciliation qui tranche.
  TIMEOUT
}

enum ContributionChannel {
  CAC
  WALLET
  BANK_TRANSFER
  CASH
  CHEQUE
  /// Saisi a la main par le back-office (versement constate sur un releve).
  MANUAL
}

model User {
  id   String @id @default(cuid())
  role Role   @default(CLIENT)

  // ✅ Nouveau
  accountType AccountType @default(CLIENT_ADHERENT)

  // ✅ Client adhérent
  fullName String?

  // ✅ Association
  // nom de l’association (champ historique réutilisé)
  companyName String?

  associationStatusDocPath String?
  representativeType      String?
  representativeName      String?
  representativePhone     String?
  representativeAddress   String?
  representativeEmail     String?
  presidentIdDocPath      String?

  // ✅ Commun
  phone   String  @unique
  phone2  String?
  email   String  @unique
  country String
  city    String
  commune String?

  passwordHash String
  status       MemberStatus @default(PENDING_VERIFICATION)

  // ✅ Docs (obligatoires côté code seulement pour CLIENT_ADHERENT)
  idDocPath  String?
  selfiePath String?

  otpLockedUntil     DateTime?
  otpSendCountHour   Int       @default(0)
  otpSendWindowStart DateTime?

  // Incrémenté pour invalider d'un coup toutes les sessions d'un compte
  // (réinitialisation de mot de passe, compromission). Les jetons émis avant
  // portent l'ancienne valeur et sont refusés.
  tokenVersion Int @default(0)

  // ✅ Invitation d'un compte interne (ADMIN / GESTIONNAIRE_DEPENSE / EQUIPE_TRESORERIE).
  // Le createur du compte ne choisit PAS le mot de passe : le titulaire le fixe
  // lui-meme via ce jeton, envoye a sa propre adresse email.
  inviteTokenHash      String?   @unique
  inviteTokenExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  otps          Otp[]
  subscriptions Subscription[]
  auditLogs     AuditLog[]
  paymentOrders          PaymentOrder[] @relation("PaymentOrderCreatedBy")
  cancelledPaymentOrders PaymentOrder[] @relation("PaymentOrderCancelledBy")

  // Trois liens distincts vers Expense : engager, approuver et rejeter sont
  // trois actes differents, portes par trois roles differents.
  expenses         Expense[] @relation("ExpenseCreatedBy")
  approvedExpenses Expense[] @relation("ExpenseApprovedBy")
  rejectedExpenses Expense[] @relation("ExpenseRejectedBy")

  @@index([status])
}

model Otp {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  channel   OtpChannel
  codeHash  String
  expiresAt DateTime
  attempts  Int        @default(0)
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId, channel, usedAt, expiresAt])
}

model Subscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bankCountry String
  bankName    String
  currency    String

  // ✅ Nouveau: méthode de paiement
  paymentMethod PaymentMethod @default(BANK_TRANSFER)

  // ✅ Si BANK_TRANSFER → mode (AUTO/MANUAL) obligatoire
  mode PaymentMode?

  // ✅ Champs banque (optionnels si WALLET)
  accountNumber String?
  rib           String?
  swiftBic      String?

  // ✅ Si WALLET (uniquement Djibouti) → provider + walletAccount
  walletProvider WalletProvider?
  walletAccount  String? // ex: numéro téléphone / wallet id

  amount    Int
  frequency Frequency

  status SubscriptionStatus @default(PENDING_CONSENT)

  // ⚠️ Ces six champs sont HISTORIQUES et figés.
  //
  // Ils ne peuvent porter qu'UN SEUL encaissement : structurellement, une
  // cotisation mensuelle de 6 000 DJF ne pouvait jamais représenter les douze
  // versements de l'année. Les encaissements vivent désormais dans
  // Contribution, un par versement. Ces colonnes restent le temps que la
  // reprise soit vérifiée, puis elles seront supprimées.
  cacPaymentRequestId String?
  cacConfirmReference String?
  cacReference        String?
  cacStatus           String?
  cacRawResponse      Json?
  paidAt              DateTime?

  /// Prochaine échéance attendue. Mise à jour à chaque encaissement confirmé.
  /// Le retard se calcule à la lecture : pas d'échéancier généré à l'avance,
  /// pas de tâche planifiée, pas de service supplémentaire à héberger.
  nextDueDate DateTime?

  contributions Contribution[]

  consentAccepted  Boolean   @default(false)
  consentVersion   String?
  consentAt        DateTime?
  consentIp        String?
  consentUserAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status])
}

model AuditLog {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action   String
  entity   String
  entityId String?
  meta     Json?

  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([action, createdAt])
  @@index([userId, createdAt])
  // La chronologie d'un dossier (GET /api/expenses/:id/trail) interroge
  // AuditLog par entity + entityId. Sans cet index, chaque ouverture de fiche
  // fait un seq scan sur une table qui ne fait que grossir.
  @@index([entity, entityId, createdAt])
}

model Expense {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  date               DateTime
  type               ExpenseType
  label              String
  quantity           Int
  unitPrice          Int
  amount             Int
  beneficiaryName    String
  beneficiaryCountry Country
  beneficiaryCity    String

  // Coordonnées de paiement du bénéficiaire, saisies par le dépensier et lues
  // par le Super Admin AU MOMENT D'APPROUVER.
  //
  // Sans elles, rien ne reliait le bénéficiaire approuvé au compte réellement
  // payé : le Super Admin approuvait « 300 000 DJF à la clinique de Balbala »,
  // et le trésorier saisissait ensuite, seul et sans revalidation, le nom de la
  // banque et le numéro de compte. Le contrôle interne ne voyait rien.
  beneficiaryBankName       String?
  beneficiaryAccountRef     String?
  beneficiaryAccountHolder  String?
  status             ExpenseStatus @default(EN_ATTENTE)

  // Qui a engagé la dépense.
  createdById String
  createdBy   User   @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  // Qui l'a approuvée. Jusqu'ici seul l'horodatage existait : l'identité de
  // l'approbateur n'était nulle part, sauf dans le journal d'audit — donc
  // impossible à afficher dans l'écran de supervision.
  approvedById        String?
  approvedBy          User?     @relation("ExpenseApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedByManagerAt DateTime?

  // Qui l'a rejetée, et pourquoi. Rejeter sans motif rend l'audit muet.
  rejectedById    String?
  rejectedBy      User?     @relation("ExpenseRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  rejectedAt      DateTime?
  rejectionReason String?

  // Horodatage de la notification envoyée à la trésorerie.
  superAdminNotifiedAt DateTime?

  paymentOrders PaymentOrder[]

  @@index([createdById, createdAt])
  @@index([status, createdAt])
}

model PaymentOrder {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Restrict)

  createdById String
  createdBy   User   @relation("PaymentOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  // Vaut expenseId tant que l'ordre est actif, NULL une fois annulé.
  // PostgreSQL autorise plusieurs NULL dans un index UNIQUE : un seul ordre
  // ACTIF par dépense, et la réémission après annulation reste possible.
  // Sans cette contrainte, deux requêtes simultanées produisaient deux ordres
  // pour la même dépense, chacun imprimable et remis à la banque.
  activeExpenseId String? @unique

  // Sortie bancaire réellement constatée.
  executedAt DateTime?

  // Annulation. Bornée par rôle : un ordre CREE (jamais imprimé) est annulable
  // par la trésorerie, un ordre IMPRIME ne l'est que par le Super Admin, un
  // ordre EXECUTE ne l'est jamais — on enregistre un remboursement, pas une
  // annulation.
  cancelledAt        DateTime?
  cancelledById      String?
  cancelledBy        User?     @relation("PaymentOrderCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  cancellationReason String?

  // Conservé nullable pour l'audit des ordres émis avant la suppression du
  // jeton d'approbation. Plus jamais alimenté.
  tokenUsedHash     String?
  paymentMethod     PaymentMethod
  currency          Currency
  paymentCountry    Country
  amount            Int
  bankCountry       Country?
  bankName          String?
  bankReference     String?
  bankAccountHolder String?
  referenceNumber   String             @unique
  status          PaymentOrderStatus @default(CREE)

  @@index([expenseId])
  @@index([createdById, createdAt])
  @@index([status])
}

/// Candidatures deposees depuis la vitrine publique : appel a projets et
/// benevolat. Avant, les deux formulaires se contentaient d'un setSubmitted(true)
/// cote navigateur : le candidat voyait un ecran de remerciement et sa
/// candidature n'existait nulle part.
model PublicSubmission {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  kind     PublicSubmissionKind
  fullName String
  email    String

  // Appel a projets
  organization String?
  theme        String?
  message      String?

  // Benevolat
  skills       String?
  availability String?

  ip        String?
  userAgent String?

  handledAt DateTime?

  @@index([kind, createdAt])
  @@index([handledAt])
}

/// Un ENCAISSEMENT : un versement réellement reçu, ou en cours de l'être.
///
/// Subscription porte l'ENGAGEMENT (le mandat : montant, périodicité,
/// consentement). Contribution porte l'argent. Les confondre était la cause
/// racine du chiffre ambigu du tableau de bord : le simple clic de
/// consentement faisait passer une cotisation en ACTIVE, et ce statut était
/// additionné comme s'il s'agissait d'une recette.
model Contribution {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  amount   Int
  currency String

  /// Échéance couverte par ce versement. Permet de dire « la mensualité de
  /// mars est impayée » sans générer d'échéancier à l'avance.
  periodStart DateTime

  status  ContributionStatus  @default(PENDING)
  channel ContributionChannel

  /// Clé d'idempotence STABLE, de la forme SUB-<id>-AAAA-MM-JJ.
  /// L'ancien venderRef contenait Date.now() et changeait à chaque clic : deux
  /// clics produisaient deux OTP valides, donc un double débit possible sans
  /// trace du premier.
  idempotencyKey String @unique

  reference   String?
  rawResponse Json?
  paidAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subscriptionId, periodStart])
  @@index([status, createdAt])
}
