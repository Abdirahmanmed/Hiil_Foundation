NODE_ENV=development
PORT=4000
DATABASE_URL=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
CORS_ORIGIN=http://localhost:5173
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_MAX_SEND_PER_HOUR=3
OTP_PEPPER=

# Email SMTP générique (Nodemailer) — ne dépend pas d’un provider précis.
# Activez un seul bloc d’exemple ci-dessous et renseignez EMAIL_USER / EMAIL_PASS.

# Exemple Gmail SMTP (compte Google avec mot de passe d’application)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=

# Exemple Brevo SMTP recommandé sur Render (SMTP transactionnel avec STARTTLS)
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=<BREVO_SMTP_LOGIN>
# EMAIL_PASS=<BREVO_SMTP_KEY>

# Timeouts SMTP configurables (utile sur Render et providers transactionnels)
EMAIL_CONNECTION_TIMEOUT_MS=30000
EMAIL_GREETING_TIMEOUT_MS=30000
EMAIL_SOCKET_TIMEOUT_MS=60000

UPLOAD_MAX_MB=10
