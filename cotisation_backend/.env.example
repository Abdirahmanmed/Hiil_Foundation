# Copier en .env et remplir. Chaque ligne correspond à une lecture réelle de
# process.env dans le code — rien d'inventé, rien d'oublié.
# Le fichier .env est ignoré par git : ne l'y remets jamais.

# ===================== SERVEUR =====================
NODE_ENV=development
PORT=4000
# Optionnel. 127.0.0.1 en local, 0.0.0.0 si la plateforme route vers le conteneur.
HOST=127.0.0.1

# ===================== BASE DE DONNÉES =====================
# REQUIS. Guillemets simples : sans eux, dotenv tronque la valeur au premier '#'.
DATABASE_URL='postgresql://user:password@host:5432/cotisation_db'
DB_POOL_MAX=10

# ===================== JWT ===================== (REQUIS)
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=8h
JWT_REFRESH_EXPIRES=7d

# ===================== CORS =====================
# Origine exacte du front, sans slash final.
CORS_ORIGIN=http://localhost:5173

# Base des liens envoyés par email (invitation, réinitialisation).
# Défaut : CORS_ORIGIN.
APP_PUBLIC_URL=http://localhost:5173

# ===================== OTP =====================
# REQUIS. Sert aussi au hachage des jetons d'invitation et de réinitialisation :
# le changer invalide TOUS les liens en cours.
OTP_PEPPER=
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_MAX_SEND_PER_HOUR=3

# ===================== EMAIL =====================
# Si BREVO_API_KEY est présent : EMAIL_FROM devient REQUIS et le transport passe
# en HTTPS (aucun socket SMTP ouvert). Sinon EMAIL_HOST, EMAIL_USER et
# EMAIL_PASS deviennent REQUIS et l'app refuse de démarrer sans eux.
BREVO_API_KEY=
EMAIL_FROM=no-reply@exemple.org
EMAIL_FROM_NAME="Hiil Foundation"
# Destinataire interne des candidatures de la vitrine. Défaut : EMAIL_FROM.
CONTACT_EMAIL=

# Repli SMTP, ignoré tant que BREVO_API_KEY existe. JAMAIS le port 25.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_CONNECTION_TIMEOUT_MS=8000
EMAIL_GREETING_TIMEOUT_MS=8000
EMAIL_SOCKET_TIMEOUT_MS=15000

# ===================== DOCUMENTS =====================
UPLOAD_MAX_MB=10
# Racine du stockage des pièces d'identité. Défaut : racine du backend.
# À faire pointer vers un disque persistant en production — sur un système de
# fichiers éphémère, les documents disparaissent à chaque redéploiement.
UPLOAD_ROOT=

# ===================== PAIEMENT CAC BANK =====================
# OBLIGATOIRE en production : le mode mock accepte l'OTP constant "123456",
# c'est un défaut ouvert. L'app refuse de démarrer sans valeur explicite.
# Valeurs : mock | live
CAC_PAYMENT_MODE=mock
CAC_CURRENCY=DJF
# Les six variables ci-dessous sont exigées AU DÉMARRAGE si le mode est "live".
CAC_BASE_URL=
CAC_USERNAME=
CAC_PASSWORD=
CAC_APP_KEY=
CAC_API_KEY=
CAC_COMPANY_SERVICE_ID=

# ===================== SEED =====================
# Requis uniquement par scripts/seed.js, pour amorcer un environnement neuf.
# ⚠️ Ces comptes ont un mot de passe connu de qui lit ce fichier. Fais-les
# changer immédiatement après le seed, et retire ces lignes de la production.
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_PHONE=77222222
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_PHONE=77000000
SEED_EXPENSE_MANAGER_EMAIL=
SEED_EXPENSE_MANAGER_PASSWORD=
SEED_EXPENSE_MANAGER_PHONE=77111111
SEED_TREASURY_EMAIL=
SEED_TREASURY_PASSWORD=
SEED_TREASURY_PHONE=77333333

# ===================== TESTS =====================
# Doit contenir « test » : le garde-fou refuse de lancer les tests autrement.
TEST_DATABASE_URL=
